# =============================================================================
# NovaChef / Guerra de Testers — exclusiones para clon limpio en GitHub
# =============================================================================

# --- Dependencias y builds ---
node_modules/
**/node_modules/
dist/
dist-ssr/
build/
*.local

# --- Python ---
.venv/
venv/
env/
ENV/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
.mypy_cache/
.ruff_cache/
.pytype/

# --- Pruebas y cobertura ---
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- Entorno y secretos (mantener solo plantillas) ---
.env
.env.*
!.env.example
!.env.*.example

# --- Base de datos local (se regenera con seed al arrancar) ---
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite3

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDEs y sistema ---
.idea/
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Herramientas locales (no necesarias al clonar) ---
*.bak
*.tmp
*.temp
~$*
